<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || t("meta.default_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= consent_mode_script_tag %>
    <%= yield :head %>
    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_typescript_tag "application.tsx" %>
  </head>
  <body>
    <div id="root"></div>
    <%= page_bootstrap_script_tag %>
    <%= yield %>
  </body>
</html>
